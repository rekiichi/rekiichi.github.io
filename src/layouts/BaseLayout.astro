---
// 全ページ共通のレイアウト。title・meta description・OGP・canonical をここで出す。
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { publicSettings } from '../lib/public-settings';
import { absoluteUrl, joinBase } from '../lib/url';
import { siteConfig, STORAGE_PREFIX } from '../site.config';

interface Props {
  /** ページ名（サイト名は自動で後ろに付く） */
  title: string;
  description: string;
  /** サイト内パス（"/" で始まる）。canonical・og:url に使う。省略時は現在のパス */
  path?: string;
  /** <title> をまるごと指定するとき（トップページなど） */
  fullTitle?: string;
  /** 検索結果に出さないページ（出題画面・マイページなど）。サイトマップからも外れる */
  noindex?: boolean;
  ogType?: 'website' | 'article';
  /** ヘッダーで強調する科目 */
  subjectId?: string;
}

const { title, description, fullTitle, noindex = false, ogType = 'website', subjectId } = Astro.props;
const base = import.meta.env.BASE_URL;
const site = Astro.site?.href ?? 'http://localhost:4321/';
const baseNoSlash = base.replace(/\/+$/, '');
const currentPath = Astro.url.pathname.startsWith(baseNoSlash)
  ? Astro.url.pathname.slice(baseNoSlash.length) || '/'
  : Astro.url.pathname;
const path = Astro.props.path ?? currentPath;
const canonical = absoluteUrl(site, base, path);
const pageTitle = fullTitle ?? `${title} | ${siteConfig.name}`;
const ogImage = absoluteUrl(site, base, siteConfig.ogImage);
const themeKey = `${STORAGE_PREFIX}theme`;
const { adsenseClient, googleSiteVerification } = publicSettings;
---

<!doctype html>
<html lang="ja" data-base={base}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f7f5f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131519" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={joinBase(base, '/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={joinBase(base, '/apple-touch-icon.png')} />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    {adsenseClient && <meta name="google-adsense-account" content={adsenseClient} />}
    {
      adsenseClient && (
        <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`} crossorigin="anonymous" />
      )
    }
    <script is:inline define:vars={{ themeKey }}>
      // 表示テーマ（ライト／ダーク）を描画前に反映して、ちらつきを防ぐ
      try {
        var t = localStorage.getItem(themeKey);
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <Header subjectId={subjectId} />
    <main id="main" class="container">
      <slot />
    </main>
    <Footer />
    <script>
      import '../client/theme';
    </script>
  </body>
</html>
