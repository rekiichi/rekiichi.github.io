---
// パンくずリスト（画面表示と、検索エンジン向けの構造化データ）
import { absoluteUrl, joinBase } from '../lib/url';

interface Crumb {
  label: string;
  /** サイト内パス。最後の項目（いまのページ）は省略可 */
  path?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
const base = import.meta.env.BASE_URL;
const site = Astro.site?.href ?? 'http://localhost:4321/';
const all: Crumb[] = [{ label: 'トップ', path: '/' }, ...items];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: all.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.path ? { item: absoluteUrl(site, base, c.path) } : {}),
  })),
};
---

<nav class="breadcrumbs" aria-label="現在地">
  <ol>
    {
      all.map((c, i) =>
        i < all.length - 1 && c.path ? (
          <li>
            <a href={joinBase(base, c.path)}>{c.label}</a>
          </li>
        ) : (
          <li>
            <span aria-current="page">{c.label}</span>
          </li>
        ),
      )
    }
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
