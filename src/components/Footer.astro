---
import { joinBase, paths } from '../lib/url';
import { siteConfig } from '../site.config';

const href = (p: string) => joinBase(import.meta.env.BASE_URL, p);
---

<footer class="site-footer">
  <div class="container">
    <nav class="footer-nav" aria-label="サイトについて">
      <a href={href(paths.guide())}>使い方</a>
      <a href={href(paths.articles())}>記事</a>
      <a href={href(paths.my())}>マイ範囲・学習記録</a>
      <a href={href(paths.privacy())}>プライバシーポリシー</a>
      <a href={href(paths.contact())}>お問い合わせ</a>
      <a href={href(paths.about())}>運営者情報</a>
    </nav>
    <p class="footer-disclaimer">教科書会社とは関係のない個人サイトです。教科書名は対応範囲を示すためだけに使用しています。</p>
    <p class="footer-copy">© {siteConfig.copyrightYear} {siteConfig.name}</p>
  </div>
</footer>
